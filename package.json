{
  "name": "hanabin",
  "version": "0.1.0",
  "private": true,
  "description": "HANABIN deterministic browser game core",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:syntax": "node scripts/check-syntax.mjs",
    "test:release": "node scripts/check-release.mjs",
    "test:m2:simulation": "node scripts/run-simulations.mjs",
    "test:browser": "playwright test",
    "test:public": "playwright test --config=playwright.public.config.mjs",
    "test:all": "npm run test:syntax && npm run test:release && npm test && npm run test:browser",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
